# Copy to .env.local (git-ignored) and fill in values. Never commit real secrets.

# Atlassian OAuth 2.0 (3LO) app credentials.
# Callback URL to register: http://localhost:3000/api/auth/callback/atlassian
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# Public base URL of the app.
APP_URL=http://localhost:3000

# Signs session cookies. At least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# AES-256-GCM key for encrypting stored API keys and Jira tokens.
# Must be base64 of exactly 32 bytes. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Optional. Unset uses embedded PGlite at ./.data/pglite.
# Set to a Postgres URL (for example from docker-compose.yml) to use a real server.
DATABASE_URL=

# Optional. OpenAI-compatible chat endpoint. The API key can also be entered in the app
# and is then stored encrypted.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Context window of the chosen model, in tokens.
LLM_CONTEXT_TOKENS=128000

# Default retention for new projects, in days (each project can change it). The hourly purge
# removes the extracted document text and the epic text of runs past it. Drafts and project files stay.
RETENTION_DAYS=7
